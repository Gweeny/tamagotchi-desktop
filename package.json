{
  "name": "tamagotchi-desktop",
  "productName": "Tamagotchi Desktop",
  "version": "0.5.4",
  "description": "Un chaton kawaii qui vit sur ton bureau et rend visite à tes amis",
  "author": "Sam",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test engine.test.js lan.test.js updater.test.js",
    "dist": "node build-icon.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "perso.sam.tamagotchi-desktop",
    "productName": "Tamagotchi Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "engine.js",
      "lan.js",
      "icon.js",
      "updater.js",
      "cat-art.js",
      "rig.js",
      "cat.css",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Tamagotchi Desktop",
      "artifactName": "Tamagotchi-Desktop-Setup-${version}.${ext}"
    }
  },
  "updateRepo": "Gweeny/tamagotchi-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gweeny/tamagotchi-desktop.git"
  }
}
